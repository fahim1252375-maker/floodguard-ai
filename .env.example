# GEMINI_API_KEY: Optional for AI features. App works with resilient hydrological fallbacks if unset.
GEMINI_API_KEY=""

# GEMINI_MODEL: Gemini model identifier (default: models/gemini-2.5-flash)
GEMINI_MODEL="models/gemini-2.5-flash"

# ADMIN_PIN: Use a private value with 6-32 characters. In production it is required. In development an ephemeral 6-digit PIN is printed at startup when unset.
ADMIN_PIN=""

# TRUST_PROXY=true                # set only when running behind exactly one trusted reverse proxy
# PORT: Server port (default: 3000)
PORT="3000"

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"

# --- Operations Center backend (SQLite via Node's built-in node:sqlite, needs Node 22.13+) ---
# Keep this directory on a persistent volume in production.
# OPS_DB_PATH=./data/floodguard.db   # database file location
# OPS_INTERVAL_MIN=15                # how often the monitoring engine records readings and checks rules
# OPS_SEED_DEMO=false                # use true only for a demo; false avoids fabricated demo history in production
# NOTIFY_WEBHOOK_URL=                # optional: POST queued SMS alerts here (SMS gateway adapter). Empty = manual outbox only
