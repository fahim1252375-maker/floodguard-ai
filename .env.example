# Optional Gemini integration. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Local development generates a temporary Admin PIN when this is blank.
# Production must set a private value between 6 and 32 characters.
ADMIN_PIN=

# Server configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# Operations Center persistence and monitoring
# Leave OPS_DB_PATH blank to use ./data/floodguard.db.
OPS_DB_PATH=
OPS_SEED_DEMO=true
OPS_INTERVAL_MIN=15

# Optional notification webhook; without a gateway adapter messages remain queued.
NOTIFY_WEBHOOK_URL=
